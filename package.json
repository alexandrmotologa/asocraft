{
  "name": "asocraft",
  "version": "0.1.0",
  "description": "Automated App Store and Google Play multi-language ASO localization pipeline with character boundary enforcement and Fastlane export.",
  "type": "module",
  "bin": {
    "asocraft": "./bin/asocraft.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "aso",
    "app-store-optimization",
    "fastlane",
    "localization",
    "ios",
    "android",
    "google-play",
    "app-store",
    "cli",
    "typescript"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrmotologa/asocraft.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/genai": "^3.0.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "openai": "^4.86.1",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
